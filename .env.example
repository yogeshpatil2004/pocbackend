# ====================================================================
# Vibodh AI Labs Backend Environment Variables (Supabase Only)
# ====================================================================

# 1. Supabase PostgreSQL Connection URL (Asyncpg)
# Format: postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_db_password@db.your_supabase_project_ref.supabase.co:5432/postgres

# 2. Supabase Storage Credentials (From Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=vibodh_assets

# 3. Clerk Authentication Secret Key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
